# Normalize line endings: LF in the repository and in the working tree,
# so scripts behave the same on Windows, Linux CI and Docker images.
* text=auto eol=lf

# Windows scripts need CRLF to run correctly in cmd.exe
*.cmd text eol=crlf
*.bat text eol=crlf

# Binary files: never touch line endings, never diff as text
*.jar binary
*.png binary
*.jpg binary
*.ico binary
